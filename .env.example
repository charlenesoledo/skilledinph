# Key names only. Copy to .env.local and fill in. Never commit real keys.

# LLM: exactly one is used. Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set.
# With neither set, the app runs in MOCK MODE.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Database: Supabase is used only when BOTH of these are set. Run supabase/schema.sql in the project first.
# With either one empty, the app uses the local JSON fallback under /data.
# The service role key is a server-side secret: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
